---
import Base from '../layouts/Base.astro';
import MatchGroup from '../components/MatchGroup.astro';
import { groupByWeek, href, results, upcoming } from '../lib/data';
import { formatRange } from '../lib/format';

const upcomingWeeks = groupByWeek(upcoming);
const resultWeeks = groupByWeek(results);
---

<Base title="Utakmice">
  <div class="page-head">
    <h1>Utakmice</h1>
    <p>
      Sve utakmice svih ekipa kluba. Kalendar se može dodati na mobitel preko
      <a href={href('/kalendar.ics')}>iCal poveznice</a>.
    </p>
  </div>

  <section class="section">
    <h2>Nadolazeće</h2>
    {
      upcomingWeeks.map((w) => (
        <MatchGroup title={formatRange([w.start, w.end])} matches={w.matches} showTeam showCompetition weekStart={w.start} weekEnd={w.end} />
      ))
    }
    {upcomingWeeks.length === 0 && <p class="empty panel">Nema zakazanih utakmica.</p>}
  </section>

  <section class="section">
    <h2>Odigrane</h2>
    {
      resultWeeks.map((w) => (
        <MatchGroup title={formatRange([w.start, w.end])} matches={w.matches} showTeam showCompetition weekStart={w.start} weekEnd={w.end} />
      ))
    }
    {resultWeeks.length === 0 && <p class="empty panel">Još nema odigranih utakmica.</p>}
  </section>
</Base>
