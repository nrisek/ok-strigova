---
import Base from '../layouts/Base.astro';
import WeekSection from '../components/WeekSection.astro';
import { groupByWeek, href, results, upcoming } from '../lib/data';
import { formatRange } from '../lib/format';

const upcomingWeeks = groupByWeek(upcoming);
const resultWeeks = groupByWeek(results);
---

<Base title="Utakmice">
  <div class="page-head">
    <p class="label">Raspored</p>
    <h1>Utakmice</h1>
    <p>
      Sve utakmice svih ekipa kluba. Kalendar se može dodati na mobitel preko
      <a href={href('/kalendar.ics')}>iCal poveznice</a>.
    </p>
  </div>

  {
    upcomingWeeks.map((w) => (
      <WeekSection label="Najava" title={formatRange([w.start, w.end])} matches={w.matches} showTeam weekStart={w.start} weekEnd={w.end} />
    ))
  }
  {upcomingWeeks.length === 0 && <p class="empty">Nema zakazanih utakmica.</p>}

  {
    resultWeeks.map((w) => (
      <WeekSection label="Rezultati" title={formatRange([w.start, w.end])} matches={w.matches} showTeam weekStart={w.start} weekEnd={w.end} />
    ))
  }
  {resultWeeks.length === 0 && <p class="empty">Još nema odigranih utakmica.</p>}
</Base>
