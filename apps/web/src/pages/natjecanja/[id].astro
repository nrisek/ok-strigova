---
import type { Competition, Match } from '@ok-strigova/scraper/model';
import Base from '../../layouts/Base.astro';
import Standings from '../../components/Standings.astro';
import WeekSection from '../../components/WeekSection.astro';
import { addDays, competitionShortName, competitions, matches, weekStartOf } from '../../lib/data';
import { formatRange } from '../../lib/format';

export function getStaticPaths() {
  return competitions.map((c) => ({ params: { id: c.id }, props: { competition: c } }));
}

interface Props {
  competition: Competition;
}

const { competition: c } = Astro.props;
const all = matches.filter((m) => m.competitionId === c.id);
const groupNames = c.groups.length > 0 ? c.groups.map((g) => g.name) : [null];

function byRound(list: Match[]): { round: number | null; dates: string[]; matches: Match[] }[] {
  const map = new Map<number | null, { round: number | null; dates: string[]; matches: Match[] }>();
  for (const m of list) {
    const entry = map.get(m.round) ?? { round: m.round, dates: m.roundDates, matches: [] };
    entry.matches.push(m);
    map.set(m.round, entry);
  }
  return [...map.values()].sort((a, b) => (a.round ?? 0) - (b.round ?? 0));
}
---

<Base title={competitionShortName(c)}>
  <div class="page-head">
    <p class="label">{c.category}</p>
    <h1>{competitionShortName(c)}</h1>
    <p>Naše ekipe: {c.clubTeams.join(', ')}.</p>
    <div class="meta-list">
      <span><a href={c.url}>Natjecanje na stranici saveza</a></span>
    </div>
  </div>

  {
    groupNames.map((name) => {
      const group = c.groups.find((g) => g.name === name);
      const list = all.filter((m) => m.group === name);
      return (
        <section class="week group">
          {name && (
            <header class="week__head">
              <div>
                <p class="label">Skupina</p>
                <h2>Skupina {name}</h2>
              </div>
            </header>
          )}
          {group && <Standings competition={c} group={group} caption={name ? undefined : 'Poredak'} />}
          {byRound(list).map((r) => (
            <WeekSection
              label={r.round !== null ? `${r.round}. kolo` : 'Utakmice'}
              title={r.dates.length > 0 ? formatRange(r.dates) : 'Turnir'}
              matches={r.matches}
              showCompetition={false}
              weekStart={r.dates[0] ? weekStartOf(r.dates[0]) : undefined}
              weekEnd={r.dates[0] ? addDays(weekStartOf(r.dates[0]), 6) : undefined}
            />
          ))}
        </section>
      );
    })
  }
</Base>
