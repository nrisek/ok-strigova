---
import Base from '../layouts/Base.astro';
import MatchList from '../components/MatchList.astro';
import NextMatch from '../components/NextMatch.astro';
import TeamSummary from '../components/TeamSummary.astro';
import { href, results, teams, upcoming } from '../lib/data';

const next = upcoming[0];
const moreUpcoming = upcoming.slice(1, 9);
const latest = results.slice(0, 8);
---

<Base title="Naslovnica">
  {next ? <NextMatch match={next} /> : <p class="empty">Trenutno nema zakazanih utakmica.</p>}

  <div class="home">
    <section class="section">
      <div class="section-head">
        <h2>Nadolazeće utakmice</h2>
        <a class="section-link" href={href('/utakmice')}>Sve utakmice</a>
      </div>
      <MatchList matches={moreUpcoming} showTeam showCompetition empty="Nema daljnjih zakazanih utakmica." />
    </section>

    <section class="section">
      <h2>Zadnji rezultati</h2>
      <MatchList matches={latest} showTeam showCompetition empty="Još nema odigranih utakmica." />
    </section>

    <aside class="section">
      <div class="section-head">
        <h2>Naše ekipe</h2>
        <a class="section-link" href={href('/ekipe')}>Sve ekipe</a>
      </div>
      <div class="team-list">{teams.map((team) => <TeamSummary team={team} />)}</div>
    </aside>
  </div>
</Base>
