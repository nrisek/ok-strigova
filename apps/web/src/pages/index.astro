---
import Base from '../layouts/Base.astro';
import MatchGroup from '../components/MatchGroup.astro';
import NextMatch from '../components/NextMatch.astro';
import TeamSummary from '../components/TeamSummary.astro';
import { groupByWeek, href, results, teams, upcoming } from '../lib/data';
import { formatRange } from '../lib/format';

const next = upcoming[0];
const upcomingWeeks = groupByWeek(upcoming.slice(0, 12));
const resultWeeks = groupByWeek(results.slice(0, 10));
---

<Base title="Naslovnica">
  {next ? <NextMatch match={next} /> : <p class="empty">Trenutno nema zakazanih utakmica.</p>}

  <div class="home">
    <section class="section">
      <div class="section-head">
        <h2>Nadolazeće utakmice</h2>
        <a class="section-link" href={href('/utakmice')}>Sve utakmice</a>
      </div>
      {
        upcomingWeeks.map((w) => (
          <MatchGroup title={formatRange([w.start, w.end])} matches={w.matches} showTeam showCompetition weekStart={w.start} weekEnd={w.end} />
        ))
      }
      {upcomingWeeks.length === 0 && <p class="empty panel">Nema zakazanih utakmica.</p>}
    </section>

    <section class="section">
      <h2>Zadnji rezultati</h2>
      {
        resultWeeks.map((w) => (
          <MatchGroup title={formatRange([w.start, w.end])} matches={w.matches} showTeam showCompetition weekStart={w.start} weekEnd={w.end} />
        ))
      }
      {resultWeeks.length === 0 && <p class="empty panel">Još nema odigranih utakmica.</p>}
    </section>

    <aside class="section">
      <div class="section-head">
        <h2>Naše ekipe</h2>
        <a class="section-link" href={href('/ekipe')}>Sve ekipe</a>
      </div>
      <div class="team-list">{teams.map((team) => <TeamSummary team={team} />)}</div>
    </aside>
  </div>
</Base>
