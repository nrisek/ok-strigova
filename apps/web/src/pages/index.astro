---
import Base from '../layouts/Base.astro';
import TeamSummary from '../components/TeamSummary.astro';
import WeekSection from '../components/WeekSection.astro';
import { groupByWeek, href, isWeekend, matchDatesOf, results, teams, upcoming } from '../lib/data';
import { formatRange, formatRangeShort } from '../lib/format';

const [firstWeek, ...laterWeeks] = groupByWeek(upcoming);
const resultWeeks = groupByWeek(results).slice(0, 2);
const heroDates = firstWeek ? matchDatesOf(firstWeek.matches) : [];
---

<Base title="Naslovnica">
  {
    firstWeek ? (
      <WeekSection
        hero
        label="Najava"
        title={isWeekend(heroDates) ? 'Utakmice vikenda' : 'Utakmice tjedna'}
        dates={formatRangeShort(heroDates)}
        matches={firstWeek.matches}
        showTeam
        weekStart={firstWeek.start}
        weekEnd={firstWeek.end}
      />
    ) : (
      <section class="week week--hero">
        <header class="week__head">
          <div>
            <p class="label">Najava</p>
            <h2>Nema zakazanih utakmica</h2>
          </div>
        </header>
      </section>
    )
  }
  {
    laterWeeks.slice(0, 2).map((w) => (
      <WeekSection label="Najava" title={formatRange([w.start, w.end])} matches={w.matches} showTeam weekStart={w.start} weekEnd={w.end} />
    ))
  }
  <a class="more" href={href('/utakmice')}>Sve utakmice</a>

  {
    resultWeeks.map((w) => (
      <WeekSection label="Rezultati" title={formatRange([w.start, w.end])} matches={w.matches} showTeam weekStart={w.start} weekEnd={w.end} />
    ))
  }

  <section class="week">
    <header class="week__head">
      <div>
        <p class="label">Klub</p>
        <h2>Naše ekipe</h2>
      </div>
      <a class="more more--small" href={href('/ekipe')}>Sve ekipe</a>
    </header>
    <div class="team-grid">{teams.map((team) => <TeamSummary team={team} />)}</div>
  </section>

  <section class="week">
    <div class="link-grid">
      <a class="link-card" href={href('/uprava')}>
        <span class="label">Klub</span>
        <span class="link-card__title">Uprava</span>
        <span class="link-card__text">Tko vodi klub, stručni stožer i nadzorni odbor.</span>
      </a>
      <a class="link-card" href={href('/sponzori')}>
        <span class="label">Partneri</span>
        <span class="link-card__title">Sponzori</span>
        <span class="link-card__text">Tko podržava klub i što je točno podržao.</span>
      </a>
    </div>
  </section>
</Base>
