---
import type { Match } from '@ok-strigova/scraper/model';
import MatchList from './MatchList.astro';

interface Props {
  title: string;
  subtitle?: string | null;
  matches: Match[];
  showTeam?: boolean;
  showCompetition?: boolean;
  /** Kad je kartica tjedan: granice tjedna (ISO), da se tekući tjedan može istaknuti. */
  weekStart?: string;
  weekEnd?: string;
}

const { title, subtitle = null, matches, showTeam = false, showCompetition = false, weekStart, weekEnd } = Astro.props;
---

<section class="card" data-week-start={weekStart} data-week-end={weekEnd}>
  <header class="card__head">
    <h3>{title}</h3>
    <span class="card__now">ovaj tjedan</span>
    {subtitle && <small>{subtitle}</small>}
  </header>
  <MatchList matches={matches} showTeam={showTeam} showCompetition={showCompetition} />
</section>
