---
import type { Match } from '@ok-strigova/scraper/model';
import MatchCard from './MatchCard.astro';

interface Props {
  matches: Match[];
  showTeam?: boolean;
  showCompetition?: boolean;
  empty?: string;
}

const { matches, showTeam = false, showCompetition = true, empty = 'Nema utakmica.' } = Astro.props;
---

{
  matches.length > 0 ? (
    <ul class="cards">
      {matches.map((m) => (
        <MatchCard match={m} showTeam={showTeam} showCompetition={showCompetition} />
      ))}
    </ul>
  ) : (
    <p class="empty">{empty}</p>
  )
}
