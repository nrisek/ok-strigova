---
import type { Match } from '@ok-strigova/scraper/model';
import { clubTeamsOf, competitionFor, competitionShortName, href } from '../lib/data';
import { formatDayFull, formatRange, formatTime } from '../lib/format';

interface Props {
  match: Match;
}

const { match: m } = Astro.props;
const competition = competitionFor(m.competitionId);
const time = m.scheduledAt ? formatTime(m.scheduledAt) : null;
const when = m.scheduledAt ? formatDayFull(m.scheduledAt) : formatRange(m.roundDates);
const team = clubTeamsOf(m)[0];
const note =
  m.status === 'postponed'
    ? 'Utakmica je odgođena, novi termin još nije objavljen.'
    : !time
      ? 'Točan termin još nije određen.'
      : null;
---

<section class="next" aria-labelledby="next-title">
  <div>
    <p class="next__label" id="next-title">Sljedeća utakmica</p>
    <p class="next__teams">
      <span class:list={{ 'is-club': m.clubTeams.includes(m.home) }}>{m.home}</span>
      <span class:list={{ 'is-club': m.clubTeams.includes(m.away) }}>{m.away}</span>
    </p>
  </div>
  <div class="next__details">
    <p class="next__when">{when}{time ? ` u ${time}` : ''}</p>
    {note && <p class="next__note">{note}</p>}
    {m.venue && <p class="next__where">{m.venue}</p>}
    {
      competition && (
        <p class="next__comp">
          <a href={href(`/natjecanja/${competition.id}`)}>{competitionShortName(competition)}</a>{m.round ? `, ${m.round}. kolo` : ''}
        </p>
      )
    }
    {
      team && (
        <p class="next__team">
          <a href={href(`/ekipe/${team.slug}`)}>Raspored ekipe</a>
        </p>
      )
    }
  </div>
</section>
